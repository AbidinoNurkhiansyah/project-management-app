# ==============================================================================
# PM-APP ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Duplicate this file to .env.local and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client SDK (Web Client Configuration)
# Dapatkan dari: Firebase Console > Project Settings > General > Your apps (Web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK (Server Actions & Server-side Verification)
# Dapatkan dari: Firebase Console > Project Settings > Service accounts > Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Zero-Egress Object Storage (S3 API Compatible)
# Dapatkan dari: Cloudflare Dashboard > R2 > Manage R2 API Tokens
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_cloudflare_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_cloudflare_r2_secret_access_key"
R2_BUCKET_NAME="pm-app-attachments"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"

# ------------------------------------------------------------------------------
# 4. Google Calendar API & OAuth 2.0 Client
# Dapatkan dari: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="123456789-xxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ------------------------------------------------------------------------------
# 5. Token Encryption Secret (AES-256-GCM)
# Generate 32 bytes hex menggunakan: openssl rand -hex 32
# ------------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
